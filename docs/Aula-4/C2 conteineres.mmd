    style WebApp fill:#FFFF00,stroke:#333,stroke-width:2px,color:#000
    style API fill:#FFA500,stroke:#333,stroke-width:2px,color:#000
    style DB fill:#ADD8E6,stroke:#333,stroke-width:2px,color:#000