flowchart LR
    Vendedor(["Vendedor"])
    Administrador(["Administrador"])
    Estoque(["Estoque"])

    subgraph SistemaDeVendas["Sistema de Vendas"]
        WebApp["Aplicacao Web<br>(Apresentacao)"]
        API["API<br>(Dominio)"]
        DB[("Banco de Dados<br>(Dados)")]
